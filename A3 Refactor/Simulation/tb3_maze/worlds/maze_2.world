<?xml version="1.0"?>
<sdf version="1.8">
  <world name="default">
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
    </include>

    <!--
      maze_2: 8 x 5 cells, 0.8 m per cell (6.4 m x 4.0 m), centred on the world origin, made with the randomized Kruskal
      maze algorithm (seed 88). Walls are 0.05 m thick and 0.5 m high. Every wall connects to the outer wall
      (a "perfect" maze with no floating rooms), so wall following can always solve it. The exit is the gap in
      the east wall. Start the robot in the S cell facing +x (x = -2.8, y = 1.6, yaw 0).
      Wall following on a grid takes 40 cell moves with the left-hand rule and 40 with the right-hand rule;
      the shortest way is 12.

      +===+===+===+===+===+===+===+===+
      | S                 |   |       |
      +===+===+   +===+===+   +   +   +
      |   |   |           |   |   |   |
      +   +   +   +===+===+   +===+   +
      |       |               |       |
      +   +===+===+   +===+   +   +===+
      |           |       |   |   |   |
      +   +   +===+   +   +   +   +   +
      |   |           |   |            
      +===+===+===+===+===+===+===+===+
    -->
    <model name="maze_2">
      <static>true</static>
      <link name="walls">
        <collision name="wall_0_collision">
          <pose>0.000 -2.000 0.25 0 0 0</pose>
          <geometry><box><size>6.450 0.050 0.5</size></box></geometry>
        </collision>
        <visual name="wall_0_visual">
          <pose>0.000 -2.000 0.25 0 0 0</pose>
          <geometry><box><size>6.450 0.050 0.5</size></box></geometry>
          <material><ambient>0.8 0.7 0.5 1</ambient><diffuse>0.8 0.7 0.5 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
        <collision name="wall_1_collision">
          <pose>-1.200 -1.200 0.25 0 0 0</pose>
          <geometry><box><size>0.850 0.050 0.5</size></box></geometry>
        </collision>
        <visual name="wall_1_visual">
          <pose>-1.200 -1.200 0.25 0 0 0</pose>
          <geometry><box><size>0.850 0.050 0.5</size></box></geometry>
          <material><ambient>0.8 0.7 0.5 1</ambient><diffuse>0.8 0.7 0.5 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
        <collision name="wall_2_collision">
          <pose>-1.600 -0.400 0.25 0 0 0</pose>
