@startuml
skinparam shadowing false
skinparam usecase {
  BackgroundColor White
  BorderColor Black
  FontSize 13
}
skinparam ArrowFontSize 12
skinparam nodesep 40
skinparam ranksep 55

usecase "TurtleBot3 hardware drivers" as Platform
usecase "project1_wall_follower\n(A2 WallFollowerNode)" as Follower
usecase "Rviz" as Rviz

Platform --> Follower : /scan
Platform --> Follower : /odom
Follower --> Platform : /cmd_vel
Follower --> Rviz     : /trajectory
Platform --> Rviz     : /scan
Platform --> Rviz     : camera image topic from bring-up
@enduml
