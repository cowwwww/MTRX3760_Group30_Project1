<launch>
  <arg name="model" default="waffle"/>
  <arg name="rviz" default="true"/>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find mtrx3760_project1)/worlds/project1_maze.world"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="paused" value="false"/>
  </include>
  <param name="robot_description" command="$(find xacro)/xacro $(find turtlebot3_description)/urdf/turtlebot3_$(arg model).urdf.xacro"/>
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"/>
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_turtlebot3"
        args="-urdf -model turtlebot3 -x 0.6 -y 0.35 -z 0.01 -param robot_description"/>
  <include file="$(find mtrx3760_project1)/launch/wall_follower.launch"/>
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find mtrx3760_project1)/config/project1_ros1.rviz"/>
</launch>
