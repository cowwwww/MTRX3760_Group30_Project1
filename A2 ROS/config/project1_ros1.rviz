Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: odom
    Background Color: 35; 35; 35
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
    - Class: rviz/RobotModel
      Name: Robot
      Enabled: true
    - Class: rviz/LaserScan
      Name: Laser
      Enabled: true
      Topic: /scan
      Size (m): 0.03
    - Class: rviz/Path
      Name: Trajectory
      Enabled: true
      Topic: /trajectory
      Color: 255; 170; 0
    - Class: rviz/Image
      Name: Camera
      Enabled: true
      Image Topic: /camera/rgb/image_raw
      Transport Hint: raw
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 9
      Pitch: 1.3
      Yaw: 0
      Focal Point:
        X: 3
        Y: 2
        Z: 0
Window Geometry:
  Width: 1200
  Height: 800
